{
  "name": "rescueroute",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A constraint-aware food rescue coordination assistant",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "evaluate": "node scripts/evaluate-intake.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "load-check": "node scripts/load-check.mjs",
    "evaluate:live": "node --env-file-if-exists=.env scripts/evaluate-live.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "check:contrast": "node scripts/audit-palette.mjs",
    "load:public-demo": "node scripts/load-public-demo.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include=lib/*.mjs --test-coverage-include=server.mjs --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=90"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.10.3",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "^26.1.0"
  }
}
