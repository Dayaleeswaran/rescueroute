# Optional. Without a key the app uses its clearly labelled local contextual intake engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000
# Public demos keep external requests off unless the owner enables this.
PUBLIC_AI_ENABLED=false
PORT=3000
# Local persistent JSON store. Run only one server process per data directory.
DATA_DIR=.data
# For cloud demonstrations only. Local mode remains the default.
PUBLIC_DEMO=false
# Required when PUBLIC_DEMO=true outside Render; HTTPS origin only.
# On Render, RENDER_EXTERNAL_URL is detected automatically.
PUBLIC_ORIGIN=
